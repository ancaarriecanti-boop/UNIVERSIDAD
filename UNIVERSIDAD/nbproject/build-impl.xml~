<?xml version="1.0" encoding="UTF-8"?>
<!--
  Archivo de construccion simplificado para el proyecto (Ant).
  build.xml lo importa. Define los objetivos que usa NetBeans:
  compile, jar, run, debug, clean, default.
-->
<project name="UNIVERSIDAD43-impl" default="default" basedir="..">

    <property file="nbproject/project.properties"/>

    <target name="-init">
        <property name="javac.source" value="17"/>
        <property name="javac.target" value="17"/>
        <property name="source.encoding" value="UTF-8"/>
        <property name="build.classes.excludes" value="**/*.java,**/*.form"/>
        <mkdir dir="${build.classes.dir}"/>
    </target>

    <target name="compile" depends="-init" description="Compila el proyecto">
        <javac srcdir="${src.dir}"
               destdir="${build.classes.dir}"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${source.encoding}"
               includeantruntime="false"
               debug="true"
               fork="false"/>
        <copy todir="${build.classes.dir}">
            <fileset dir="${src.dir}" excludes="${build.classes.excludes}"/>
        </copy>
    </target>

    <target name="jar" depends="compile" description="Crea el .jar">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}" compress="${jar.compress}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="compile" description="Ejecuta el proyecto">
        <java classname="${main.class}" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="debug" depends="compile" description="Ejecuta el proyecto (sin depurador)">
        <java classname="${main.class}" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="clean" description="Borra build y dist">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="default" depends="jar"/>
</project>
